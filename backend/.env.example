# FitTrack 后端环境变量示例：复制为 .env 后按需修改

# ---------- 数据库 ----------
# MySQL（生产推荐，需要先建库并执行 sql/schema_mysql.sql）
DATABASE_URL=mysql+pymysql://root:123456@127.0.0.1:3306/fittrack?charset=utf8mb4
# 本地零依赖演示可以改成 SQLite：
# DATABASE_URL=sqlite:///./fittrack.db

DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ---------- JWT ----------
# 生产环境务必换成随机长字符串，例如 python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=fittrack-dev-secret-please-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
ADMIN_JWT_EXPIRE_MINUTES=720

# ---------- 上传 ----------
MAX_UPLOAD_SIZE=5242880
# UPLOAD_DIR=D:/d/bbbsss/backend/uploads

# ---------- 业务 ----------
CHECKIN_POINTS=10
CHECKIN_STREAK_BONUS=5
CHECKIN_STREAK_BONUS_CAP=30

# ---------- 默认管理员（首次启动自动创建） ----------
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123456

DEBUG=true
